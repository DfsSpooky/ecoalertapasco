# =========================================================================
# ARCHIVO DE CONFIGURACIÓN (.env) - ECOALERTA 🌱
# =========================================================================

# 💻 CONFIGURACIÓN DEL BACKEND (DJANGO)
DEBUG=True
SECRET_KEY=django-insecure-cambiame-por-una-llave-segura-en-produccion-123456
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend
FRONTEND_URL=http://localhost:8080

# 🗄️ CONFIGURACIÓN DE LA BASE DE DATOS (POSTGRESQL)
# Para docker-compose, DB_HOST es el nombre del servicio de la db ("db")
DB_HOST=db
DB_PORT=5432
DB_NAME=ecoalerta
DB_USER=ecoalerta_user
DB_PASSWORD=ecoalerta_secure_pwd

# 🎨 CONFIGURACIÓN DEL FONTEND (FLUTTER)
BACKEND_URL=http://localhost:8000
