# ==============================================================================
# EcoAlerta Backend - Plantilla de Variables de Entorno de Producción
# ==============================================================================
# Copia este archivo como '.env' en tu servidor o configura estas variables
# en el panel de Coolify, Render, Railway o tu contenedor Docker.
# ==============================================================================

# 1. SEGURIDAD DJANGO
# ------------------------------------------------------------------------------
# Genera una clave segura de 50 caracteres ejecutando en tu terminal:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=coloca_aqui_tu_clave_secreta_de_produccion_aleatoria

# En producción DEBE ser False
DEBUG=False

# Dominios y subdominios que apuntan a tu API (separados por comas)
# Ejemplo: api.ecoalerta.pe,api.ecoalerta.tudominio.com
ALLOWED_HOSTS=api.ecoalerta.tudominio.com,localhost,127.0.0.1


# 2. CORS & CSRF (Conexión con el Frontend Flutter Web)
# ------------------------------------------------------------------------------
# El dominio público donde está alojada tu web de Flutter
# Ejemplo: https://ecoalerta.tudominio.com,http://localhost:8080
CORS_ALLOWED_ORIGINS=https://ecoalerta.tudominio.com,http://localhost:8080
CSRF_TRUSTED_ORIGINS=https://ecoalerta.tudominio.com,https://api.ecoalerta.tudominio.com


# 3. BASE DE DATOS (PostgreSQL)
# ------------------------------------------------------------------------------
# Opción A: URL completa de conexión (útil para Neon, Supabase o Railway)
# DATABASE_URL=postgresql://usuario:password@host:5432/ecoalerta

# Opción B: Parámetros individuales (estándar para Coolify o Docker Compose)
DB_HOST=db
DB_NAME=ecoalerta
DB_USER=ecoalerta_user
DB_PASSWORD=contraseña_segura_de_tu_base_de_datos
DB_PORT=5432


# 4. INTELIGENCIA ARTIFICIAL (Google Gemini API)
# ------------------------------------------------------------------------------
# Clave de API de Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSy_tu_clave_de_gemini_aqui
GEMINI_MODEL=gemini-3.5-flash
