# =========================================================================
# ARCHIVO DE CONFIGURACIÓN DE EJEMPLO (.env.example) - ECOALERTA 🌱
# =========================================================================
# Copia este archivo como '.env' en la raíz y configura tus valores para
# producción y desarrollo local.

# -------------------------------------------------------------------------
# 💻 CONFIGURACIÓN DEL BACKEND (DJANGO)
# -------------------------------------------------------------------------
# Define si se activa el modo depuración (True para desarrollo, False para producción)
DEBUG=True

# Llave secreta para la firma criptográfica (¡Genera una segura en producción!)
SECRET_KEY=django-insecure-cambiame-por-una-llave-segura-en-produccion-123456

# Dominios permitidos separados por comas (Obligatorio si DEBUG=False)
# Ej: ecoalerta.tudominio.com,api.ecoalerta.tudominio.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes CORS permitidos (Dirección del frontend web)
FRONTEND_URL=http://localhost:8080

# Orígenes confiables para CSRF en producción (separados por coma)
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://ecoalerta.local

# Ruta personalizada para la consola de administración (sin / al inicio ni al final)
DJANGO_ADMIN_PATH=ecoalerta-secret-admin-portal

# Credenciales para superusuario automático administrable en producción
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=AdminPass123!
DJANGO_SUPERUSER_EMAIL=admin@ecoalerta.gov.pe

# -------------------------------------------------------------------------
# 🗄️ CONFIGURACIÓN DE LA BASE DE DATOS (POSTGRESQL)
# -------------------------------------------------------------------------
# Motor de base de datos a usar. Puedes dejar vacíos estos campos para usar SQLite (por defecto).
# Para usar Postgres, rellena las siguientes variables:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecoalerta
DB_USER=ecoalerta_user
DB_PASSWORD=ecoalerta_secure_pwd

# (Opcional) Si tu hosting o proveedor te da un string de conexión directa de Postgres:
# DATABASE_URL=postgresql://ecoalerta_user:ecoalerta_secure_pwd@localhost:5432/ecoalerta

# -------------------------------------------------------------------------
# 🎨 CONFIGURACIÓN DEL FONTEND (FLUTTER)
# -------------------------------------------------------------------------
# Dirección base del API del backend para que la aplicación web se comunique.
# Ej: https://api.ecoalerta.tudominio.com
BACKEND_URL=http://localhost:8000

# -------------------------------------------------------------------------
# 🤖 BOT DE TELEGRAM PARA ALERTAS DE EMERGENCIA CRÍTICAS (OPCIONAL)
# -------------------------------------------------------------------------
# Token de tu bot de Telegram obtenido a través de @BotFather
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# ID del chat o grupo donde se enviarán las alertas (puedes usar @userinfobot para obtener tu ID)
# TELEGRAM_CHAT_ID=-100123456789
